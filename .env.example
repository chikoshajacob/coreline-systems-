# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.

PORT=3000

# EmailJS configuration for the website contact form.
# Create a service and email template in your EmailJS dashboard.
EMAILJS_SERVICE_ID=service_vjy3jmf
EMAILJS_TEMPLATE_ID=template_sxs837n
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key
EMAILJS_TO_EMAIL=matemarumbidzai2@gmail.com

# Gmail address and App Password used for subscription notifications.
EMAIL_USER=youraddress@gmail.com

# A Gmail App Password — NOT your normal Gmail password.
# Generate one at: https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification to be turned on for your Google account first.)
EMAIL_PASS=your16characterapppassword

# The default address for subscription notifications
EMAIL_TO=matemarumbidzai2@gmail.com

# Dedicated public inboxes
SUPPORT_EMAIL=support@corelinesystem.co.zw
INFO_EMAIL=info@corelinesystem.co.zw
